+public class ValidatorBehaviorTest extends WicketTestCase
+{
+
+	/**
+	 * Tests validators are treated as behaviors
+	 */
+	@Test
+	public void actAsBehavior()
+	{
+		TestPage page = new TestPage();
+
+		tester.startPage(page);
+		assertFalse(tester.getLastResponseAsString().contains("foo=\"bar\""), () -> "Add assertion message");
+
+		MaxLenValidator max = new MaxLenValidator();
+		page.name.add(max);
+		tester.startPage(page);
+		tester.assertContains("foo=\"bar\"");
+
+		page.name.remove(max);
+		tester.startPage(page);
+		// Line removed due to Duplicate Assert: assertFalse(tester.getLastResponseAsString().contains("foo=\"bar\""), () -> "Add assertion message");
+	}
+
+
+	/**
+	 * Tests that disabled validators are not used
+	 * https://issues.apache.org/jira/browse/WICKET-5897
+	 */
+	@Test
+	public void disabledValidator()
+	{
+		TestPage page = new TestPage();
+		page.name.add(new DisabledValidator());
+
+		tester.startPage(page);
+		assertTrue(page.name.isValid(), () -> "Add assertion message");
+
+		FormTester ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+
+		// Line removed due to Duplicate Assert: assertTrue(page.name.isValid(), () -> "Add assertion message");
+	}
+
+
+	/**
+	 * Tests validators are treated as validators
+	 */
+	@Test
+	public void actAsValidator()
+	{
+		TestPage page = new TestPage();
+
+		tester.startPage(page);
+
+		FormTester ft = tester.newFormTester("form");
+		ft.setValue("name", "999999999");
+		ft.submit();
+		Integer magicNumber22368257 = 0; 	 // It is highly advisible to rename this variable to something that better encapsulate its meaning. 
+		assertEquals(magicNumber22368257, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		MaxLenValidator max = new MaxLenValidator();
+		page.name.add(max);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "999999999");
+		ft.submit();
+		assertEquals(1, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+		// WICKET-5115 variables in default message are not substituted (was the case in 1.5.x)
+		assertEquals("MAX ${len}", new FeedbackCollector(page).collect()
+			.get(0)
+			.getMessage()
+			.toString(), () -> "Add assertion message");
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		MinLenValidator min = new MinLenValidator();
+		page.name.add(min);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(1, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+		assertEquals("MINIMUM", new FeedbackCollector(page).collect()
+			.get(0)
+			.getMessage()
+			.toString(), () -> "Add assertion message");
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "7777777");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		page.name.remove(min);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		page.name.remove(max);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "999999999");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+	}
+
+	/**
+	 */
+	public static class MaxLenValidator extends Behavior implements IValidator<String>
+	{
+		private static final long serialVersionUID = 1L;
+		private final int len = 8;
+
+		@Override
+		public void validate(IValidatable<String> validatable)
+		{
+			String value = validatable.getValue();
+			if (value.length() > len)
+			{
+				ValidationError error = new ValidationError();
+				error.setVariable("len", len);
+				error.setMessage("MAX ${len}");
+				validatable.error(error);
+			}
+		}
+
+		@Override
+		public void onComponentTag(Component component, ComponentTag tag)
+		{
+			tag.put("foo", "bar");
+		}
+	}
+
+	/**
+	 */
+	public static class MinLenValidator extends Behavior implements IValidator<String>
+	{
+		private static final long serialVersionUID = 1L;
+		private int len = 5;
+
+		@Override
+		public void validate(IValidatable<String> validatable)
+		{
+			String value = validatable.getValue();
+			if (value.length() < len)
+			{
+				ValidationError error = new ValidationError();
+				error.setMessage("MINIMUM");
+				validatable.error(error);
+			}
+		}
+	}
+
+	/**
+	 */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+		private TextField<String> name;
+
+		/**
+		 * Construct.
+		 */
+		public TestPage()
+		{
+			Form<Void> form = new Form<>("form");
+			add(form);
+			name = new TextField<>("name", Model.of(""));
+			form.add(name);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<form wicket:id='form'><input wicket:id='name' type='text'/></form>");
+		}
+	}
+
+	public static class DisabledValidator extends Behavior implements IValidator<String>
+	{
+		private static final long serialVersionUID = 1L;
+
+		@Override
+		public void validate(IValidatable<String> validatable)
+		{
+			ValidationError error = new ValidationError();
+			error.setMessage("validate() method should not be executed");
+			validatable.error(error);
+		}
+
+		@Override
+		public boolean isEnabled(Component component)
+		{
+			return false;
+		}
+	}
+}
