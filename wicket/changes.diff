+	@Test
+	public void testContentRange()
+	{
+		// Test range
+		Assert.assertEquals("resource", makeRangeRequest("bytes=0-7"), () -> "Add assertion message");
+		Assert.assertEquals("ource", makeRangeRequest("bytes=3-7"), () -> "Add assertion message");
+		Assert.assertEquals("resource_var_style_en.txt", makeRangeRequest("bytes=0-"), () -> "Add assertion message");
+		Assert.assertEquals("var_style_en.txt", makeRangeRequest("bytes=9-"), () -> "Add assertion message");
+		Assert.assertEquals("resource_var_style_en.txt", makeRangeRequest("bytes=-"), () -> "Add assertion message");
+		Assert.assertEquals("resource_var_style_en.txt", makeRangeRequest("bytes=-25"), () -> "Add assertion message");
+	}
