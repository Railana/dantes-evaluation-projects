+			String enc = LongEncoder.encode(i);
+			Assert.assertFalse("uniqueness: " + i, encoded.contains(enc));
+			encoded.add(enc);
+			Assert.assertEquals("decoding: " + i, i, LongEncoder.decode(enc));
+		}
+	}
