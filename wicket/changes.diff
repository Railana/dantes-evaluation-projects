+/**
+ */
+public class FormValidatorBehaviorTest extends WicketTestCase
+{
+	/**
+	 * Tests validators are treated as behaviors
+	 */
+	@Test
+	public void actAsBehavior()
+	{
+		TestPage page = new TestPage();
+
+		tester.startPage(page);
+
+		assertFalse(tester.getPreviousRequests().contains("foo=\"bar\""), () -> "Add assertion message");
+
+		MaxLenValidator validator = new MaxLenValidator(page.name);
+		page.form.add(validator);
+		tester.startPage(page);
+
+		tester.assertContains("foo=\"bar\"");
+
+		page.form.remove(validator);
+
+		// Line removed due to Duplicate Assert: assertFalse(tester.getPreviousRequests().contains("foo=\"bar\""), () -> "Add assertion message");
+	}
+
+	/**
+	 * Tests validators are treated as validators
+	 */
+	@Test
+	public void actAsValidator()
+	{
+		TestPage page = new TestPage();
+
+		tester.startPage(page);
+
+		FormTester ft = tester.newFormTester("form");
+		ft.setValue("name", "999999999");
+		ft.submit();
+		Integer magicNumber21503361 = 0; 	 // It is highly advisible to rename this variable to something that better encapsulate its meaning. 
+		assertEquals(magicNumber21503361, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		MaxLenValidator max = new MaxLenValidator(page.name);
+		page.form.add(max);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "999999999");
+		ft.submit();
+		assertEquals(1, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+		assertEquals("MAX", new FeedbackCollector(page).collect()
+			.get(0)
+			.getMessage()
+			.toString(), () -> "Add assertion message");
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		MinLenValidator min = new MinLenValidator(page.name);
+		page.form.add(min);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(1, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+		assertEquals("MINIMUM", new FeedbackCollector(page).collect()
+			.get(0)
+			.getMessage()
+			.toString(), () -> "Add assertion message");
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "7777777");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		page.form.remove(min);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "22");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+		page.form.remove(max);
+
+		ft = tester.newFormTester("form");
+		ft.setValue("name", "999999999");
+		ft.submit();
+		// Line removed due to Duplicate Assert: assertEquals(0, new FeedbackCollector(page).collect().size(), () -> "Add assertion message");
+
+	}
+
+	/**
+	 */
+	public static class MaxLenValidator extends Behavior implements IFormValidator
+	{
+		private static final long serialVersionUID = 1L;
+		private final int len = 8;
+		private final TextField<String> field;
+
+		/**
+		 * Construct.
+		 * 
+		 * @param field
+		 */
+		public MaxLenValidator(TextField<String> field)
+		{
+			this.field = field;
+		}
+
+		@Override
+		public void onComponentTag(Component component, ComponentTag tag)
+		{
+			tag.put("foo", "bar");
+		}
+
+		@Override
+		public FormComponent<?>[] getDependentFormComponents()
+		{
+			return new FormComponent[] { field };
+		}
+
+		@Override
+		public void validate(Form<?> form)
+		{
+			String value = field.getConvertedInput();
+			if (value.length() > len)
+			{
+				form.error("MAX");
+			}
+		}
+	}
+
+	/**
+	 */
+	public static class MinLenValidator implements IFormValidator
+	{
+		private static final long serialVersionUID = 1L;
+		private int len = 5;
+		private final TextField<String> field;
+
+		/**
+		 * Construct.
+		 * 
+		 * @param field
+		 */
+		public MinLenValidator(TextField<String> field)
+		{
+			this.field = field;
+		}
+
+		@Override
+		public FormComponent<?>[] getDependentFormComponents()
+		{
+			return new FormComponent[] { field };
+		}
+
+		@Override
+		public void validate(Form<?> form)
+		{
+			String value = field.getConvertedInput();
+			if (value.length() < len)
+			{
+				form.error("MINIMUM");
+			}
+		}
+	}
+
+	/**
+	 */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+		/**	 */
+		public TextField<String> name;
+		/**	 */
+		public Form<Void> form;
+
+		/**
+		 * Construct.
+		 */
+		public TestPage()
+		{
+			form = new Form<Void>("form");
+			add(form);
+			name = new TextField<String>("name", Model.of(""));
+			form.add(name);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<form wicket:id='form'><input wicket:id='name' type='text'/></form>");
+		}
+	}
