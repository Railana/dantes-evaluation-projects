+	/**
+	 * 
+	 * @throws Exception
+	 */
+	@SuppressWarnings({ "unchecked" })
+	@Test
+	public void test1() throws Exception
+	{
+		// How does the test work: Make sure you have a page, form and form component properly set
+		// up (getRelativePath() etc.). See #before().
+		final Page page = tester.getLastRenderedPage();
+
+		// Get the form and form component created
+		final TestForm form = (TestForm)page.get("form");
+		final TextField<String> textField = (TextField<String>)form.get("input");
+
+		// Right after init, the requests and responses cookie lists must be empty
+		Integer magicNumber88658520 = 0; 	 // It is highly advisible to rename this variable to something that better encapsulate its meaning. 
+		assertEquals(magicNumber88658520, getRequestCookies().size(), () -> "Add assertion message");
+		assertEquals(0, getResponseCookies().size(), () -> "Add assertion message");
+
+		// Create a persister for the test
+		final CookieUtils persister = new CookieUtils();
+
+		// See comment in CookieUtils on how removing a Cookies works. As no cookies in the request,
+		// no "delete" cookie will be added to the response.
+		persister.remove(textField);
+		// Line removed due to Duplicate Assert: assertEquals(0, getRequestCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(0, getResponseCookies().size(), () -> "Add assertion message");
+
+		// Save the input field's value (add it to the response's cookie list)
+		persister.save(textField);
+		assertTrue(getRequestCookies().isEmpty(), () -> "Add assertion message");
+		assertEquals(1, getResponseCookies().size(), () -> "Add assertion message");
+		assertEquals("test", (getResponseCookies().get(0)).getValue(), () -> "Add assertion message");
+		assertEquals("form.input", (getResponseCookies().get(0)).getName(), () -> "Add assertion message");
+		assertEquals(tester.getRequest().getContextPath() + tester.getRequest().getServletPath(),
+			(getResponseCookies().get(0)).getPath(), () -> "Add assertion message");
+
+		// To remove a cookie means to add a cookie with maxAge=0. Provided a cookie with the same
+		// name has been provided in the request. Thus, no changes in our test case
+		persister.remove(textField);
+		// Line removed due to Duplicate Assert: assertEquals(0, getRequestCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(1, getResponseCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals("test", (getResponseCookies().get(0)).getValue(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals("form.input", (getResponseCookies().get(0)).getName(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(tester.getRequest().getContextPath() + tester.getRequest().getServletPath(),
+			(getResponseCookies().get(0)).getPath(), () -> "Add assertion message");
+
+		// Try to load it. Because there is no Cookie matching the textfield's name the model's
+		// value remains unchanged
+		persister.load(textField);
+		assertEquals("test", textField.getDefaultModelObjectAsString(), () -> "Add assertion message");
+
+		// Simulate loading a textfield. Initialize textfield with a new (default) value, copy the
+		// cookie from response to request (simulating a browser), than load the textfield from
+		// cookie and voala the textfield's value should change.
+		// save means: add it to the response
+		// load means: take it from request
+		// Line removed due to Duplicate Assert: assertEquals("test", textField.getDefaultModelObjectAsString(), () -> "Add assertion message");
+		textField.setDefaultModelObject("new text");
+		assertEquals("new text", textField.getDefaultModelObjectAsString(), () -> "Add assertion message");
+		copyCookieFromResponseToRequest();
+		assertEquals(1, getRequestCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(1, getResponseCookies().size(), () -> "Add assertion message");
+
+		persister.load(textField);
+		// Line removed due to Duplicate Assert: assertEquals("test", textField.getDefaultModelObjectAsString(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(1, getRequestCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(1, getResponseCookies().size(), () -> "Add assertion message");
+
+		// remove all cookies from mock response. Because I'll find the cookie to be removed in the
+		// request, the persister will create a "delete" cookie to remove the cookie on the client
+		// and add it to the response. The already existing Cookie from the previous test gets
+		// removed from response since it is the same.
+		persister.remove(textField);
+		// Line removed due to Duplicate Assert: assertEquals(1, getRequestCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals(1, getResponseCookies().size(), () -> "Add assertion message");
+		// Line removed due to Duplicate Assert: assertEquals("form.input", (getResponseCookies().get(0)).getName(), () -> "Add assertion message");
+		assertEquals(0, (getResponseCookies().get(0)).getMaxAge(), () -> "Add assertion message");
+	}
