+	@Test
+	public void testContentRangeLarge() throws IOException
+	{
+		InputStream resourceAsStream = null;
+		try
+		{
+			resourceAsStream = PackageResourceReference.class.getResourceAsStream("resource_gt_4096.txt");
+			String content = new String(IOUtils.toByteArray(resourceAsStream));
+
+			// Check buffer comprehensive range request
+			String bytes4094_4105 = makeRangeRequestToBigResource("bytes=4094-4105");
+			Integer magicNumber94545677 = 12; 	 // It is highly advisible to rename this variable to something that better encapsulate its meaning. 
+			assertEquals(magicNumber94545677, bytes4094_4105.length(), () -> "Add assertion message");
+			assertEquals("River Roller", bytes4094_4105, () -> "Add assertion message");
+
+			// Check buffer exceeding range request
+			String bytes1000_4999 = makeRangeRequestToBigResource("bytes=1000-4999");
+			Integer magicNumber85119230 = 4000; 	 // It is highly advisible to rename this variable to something that better encapsulate its meaning. 
+			assertEquals(magicNumber85119230, bytes1000_4999.length(), () -> "Add assertion message");
+			assertEquals(content.substring(1000, 5000), bytes1000_4999, () -> "Add assertion message");
+
+			// Check buffer exceeding range request until end of content
+			String bytes1000_end = makeRangeRequestToBigResource("bytes=1000-");
+			assertEquals(4529, bytes1000_end.length(), () -> "Add assertion message");
+			assertEquals(content.substring(1000, content.length()), bytes1000_end, () -> "Add assertion message");
+
+			// Check complete range request
+			assertEquals(content.length(), makeRangeRequestToBigResource("bytes=-").length(), () -> "Add assertion message");
+		}
+		finally
+		{
+			IOUtils.closeQuietly(resourceAsStream);
+		}
+	}
