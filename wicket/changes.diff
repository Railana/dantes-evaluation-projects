+		assertTrue(response.contains(EscapeTestPage.TEST_QUERY_STRING), () -> "Add assertion message");
+
+		tester.executeAjaxEvent("form:textfield", "change");
+
+		EscapeTestPage testPage = (EscapeTestPage)tester.getLastRenderedPage();
+		IRequestParameters lastParameters = testPage.getLastQueryParameters();
+		assertEquals(StringValue.valueOf("value_1"), lastParameters.getParameterValue("query_p_1"), () -> "Add assertion message");
+	}
